; Endfield - Aurorae theme sizing (order S-kwin, from ds-window-v2.html).
;
; INSTALL NOTE: Aurorae loads the theme settings from the theme directory under the
; name "<theme-directory>rc", i.e. Endfieldrc next to decoration.svg. This repo ships
; the file under the order's name EndfieldDecorationrc - rename it to Endfieldrc when
; installing (see README.md). If your KWin expects a different file name the README
; says what to try; the values below are the mockup's pixel sizes either way.
;
; Mockup geometry these numbers come from (ds-window-v2.html + ds-shell.css):
;   .win    border 1px (rgba(255,255,255,.10) unfocused / .22 focused), square corners
;   .wtop   height 34px, padding-left 14px, gap 10px, hairline under it (full width)
;   .wb     40x34px button cells, no gap between them, 11px glyphs
;   focused title has a 3x11px yellow tick at x=14 (inside frame), then 10px gap.

[General]
; title strip height (mockup .wtop = 34px)
TitleHeight=34
; title text inset inside the title strip:
;   14px padding + 3px yellow tick + 10px gap = 27px from the inner left edge.
;   NOTE: the mockup shows the tick only when focused (unfocused title sits at 14px);
;   Aurorae has one inset for both states, so the title keeps 27px and stays put when
;   focus changes. See README "Could not match".
TitleEdgeLeft=27
TitleEdgeRight=10
TitleEdgeTop=0
TitleEdgeBottom=0
; 1px hairline frame on all four sides (mockup .win border)
BorderTop=1
BorderBottom=1
BorderLeft=1
BorderRight=1
; button cells (mockup .wb = 40x34px, .wctl gap 0)
ButtonWidth=40
ButtonHeight=34
ButtonSpacing=0
