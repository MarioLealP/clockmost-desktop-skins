+// clockmost: let Python (tab_bar.py) draw text-sizing-protocol cells - the same cells
+// OSC 66 produces - so a custom tab bar can use smaller, spaced labels.
+// draw_multicell(text, width=0, scale=1, subscale_n=0, subscale_d=0, vertical_align=0, horizontal_align=0)
+static PyObject *
+draw_multicell(Screen *self, PyObject *args, PyObject *kw) {
+    static const char *kwlist[] = {"text", "width", "scale", "subscale_n", "subscale_d", "vertical_align", "horizontal_align", NULL};
+    const char *text; Py_ssize_t text_sz;
+    MultiCellCommand cmd = {.scale = 1};
+    if (!PyArg_ParseTupleAndKeywords(args, kw, "s#|IIIIII", (char**)kwlist, &text, &text_sz, &cmd.width, &cmd.scale,
+                &cmd.subscale_n, &cmd.subscale_d, &cmd.vertical_align, &cmd.horizontal_align)) return NULL;
+    cmd.payload_sz = (size_t)text_sz;
+    screen_handle_multicell_command(self, &cmd, (const uint8_t*)text);
+    Py_RETURN_NONE;
+}
+
 static PyObject *
 draw(Screen *self, PyObject *src) {
     if (!PyUnicode_Check(src)) {
@@ -7182,6 +7197,7 @@ static PyMethodDef methods[] = {
     METHODB(test_create_write_buffer, METH_NOARGS),
     METHODB(test_commit_write_buffer, METH_VARARGS),
     METHODB(test_parse_written_data, METH_VARARGS),
+    {"draw_multicell", (PyCFunction)(void(*)(void))draw_multicell, METH_VARARGS | METH_KEYWORDS, "draw text-sizing cells (clockmost)"},
